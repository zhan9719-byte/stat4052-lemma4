import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.Analysis.InnerProductSpace.Projection.FiniteDimensional
import Mathlib.Analysis.InnerProductSpace.Symmetric

namespace Lemma4

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E]

/-- Orthogonal projection onto `K`, as a linear endomorphism of the ambient space. -/
noncomputable def projector (K : Submodule ℝ E) : E →ₗ[ℝ] E :=
  K.starProjection.toLinearMap

theorem projector_isSymmetric (K : Submodule ℝ E) : (projector K).IsSymmetric :=
  K.inner_starProjection_left_eq_right

variable {n p : ℕ}

/-- Column `j` of `X`, with the Euclidean inner product on the row coordinates. -/
def columnVector (X : Matrix (Fin n) (Fin p) ℝ) (j : Fin p) :
    EuclideanSpace ℝ (Fin n) :=
  WithLp.toLp 2 (fun i : Fin n => X i j)

/-- The subspace generated by the columns of `X` whose indices lie in `A`. -/
def columnSpan (X : Matrix (Fin n) (Fin p) ℝ) (A : Finset (Fin p)) :
    Submodule ℝ (EuclideanSpace ℝ (Fin n)) :=
  Submodule.span ℝ (columnVector X '' (A : Set (Fin p)))

/-- The projection `P_A` onto the span of the selected columns. -/
noncomputable def columnProjection (X : Matrix (Fin n) (Fin p) ℝ) (A : Finset (Fin p)) :
    EuclideanSpace ℝ (Fin n) →ₗ[ℝ] EuclideanSpace ℝ (Fin n) :=
  projector (columnSpan X A)

end Lemma4
